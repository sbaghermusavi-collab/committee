<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">


    <changeSet id="1-sessionattendance-create-table" author="seyyed">
        <createTable tableName="session_attendance">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="delegate_assignment_id" type="VARCHAR(36)"/>
            <column name="attendance_status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="signed_minutes" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="arrival_time" type="TIMESTAMP"/>
            <column name="departure_time" type="TIMESTAMP"/>

            <!-- Auditable Fields -->
            <column name="d_created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="c_created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="d_last_modified_date" type="TIMESTAMP"/>
            <column name="c_last_modified_by" type="VARCHAR(255)"/>
            <column name="n_version" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseColumnNames="session_id"
                baseTableName="session_attendance"
                constraintName="fk_sessionattendance_session"
                referencedColumnNames="id"
                referencedTableName="committee_session"/>

        <addForeignKeyConstraint
                baseColumnNames="assignment_id"
                baseTableName="session_attendance"
                constraintName="fk_sessionattendance_assignment"
                referencedColumnNames="id"
                referencedTableName="committee_member_assignment"/>

        <addForeignKeyConstraint
                baseColumnNames="delegate_assignment_id"
                baseTableName="session_attendance"
                constraintName="fk_sessionattendance_delegate_assignment"
                referencedColumnNames="id"
                referencedTableName="committee_member_assignment"/>
    </changeSet>

</databaseChangeLog>