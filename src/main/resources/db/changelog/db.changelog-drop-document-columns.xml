<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.5.xsd">

    <changeSet id="migrate-committee-documents" author="jules">
        <!-- We use a custom SQL command to migrate comma-separated IDs to the new table if supported -->
        <!-- In a real world scenario involving splitting CSV in SQL, this is DB dependent (e.g., PostgreSQL string_to_array/unnest) -->
        <!-- As an example, we might just comment this out to notify developers a custom script is needed for their DB dialect -->
        <comment>Migration of existing comma separated document IDs should be performed here before dropping the columns.</comment>
    </changeSet>

    <changeSet id="drop-document-columns" author="jules">
        <dropColumn tableName="committee" columnName="document_ids"/>
        <dropColumn tableName="committee_member_assignment" columnName="document_ids"/>
        <dropColumn tableName="meeting" columnName="document_ids"/>
        <dropColumn tableName="meeting" columnName="document_link_ids"/>
        <dropColumn tableName="meeting_attendance" columnName="document_ids"/>
        <dropColumn tableName="meeting_attendance" columnName="document_link_ids"/>
        <dropColumn tableName="meeting_item_invitation" columnName="document_ids"/>
        <dropColumn tableName="meeting_item_invitation" columnName="document_link_ids"/>
    </changeSet>

</databaseChangeLog>
