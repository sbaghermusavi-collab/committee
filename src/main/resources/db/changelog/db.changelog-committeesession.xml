<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">


    <changeSet id="1-committeesession-create-table" author="seyyed">
        <createTable tableName="committee_session">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="committee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="session_number" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="session_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="session_time" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="VARCHAR(36)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="agenda" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="session_nature_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="status_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="document_id" type="VARCHAR(255)"/>

            <!-- Auditable Fields -->
            <column name="d_created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="c_created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="d_last_modified_date" type="TIMESTAMP"/>
            <column name="c_last_modified_by" type="VARCHAR(255)"/>
            <column name="n_version" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseColumnNames="committee_id"
                baseTableName="committee_session"
                constraintName="fk_committeesession_committee"
                referencedColumnNames="id"
                referencedTableName="committee"/>

        <addForeignKeyConstraint
                baseColumnNames="location_id"
                baseTableName="committee_session"
                constraintName="fk_committeesession_location"
                referencedColumnNames="id"
                referencedTableName="base_info"/>

        <addForeignKeyConstraint
                baseColumnNames="session_nature_id"
                baseTableName="committee_session"
                constraintName="fk_committeesession_session_nature"
                referencedColumnNames="id"
                referencedTableName="base_info"/>

        <addForeignKeyConstraint
                baseColumnNames="status_id"
                baseTableName="committee_session"
                constraintName="fk_committeesession_status"
                referencedColumnNames="id"
                referencedTableName="base_info"/>
    </changeSet>

</databaseChangeLog>