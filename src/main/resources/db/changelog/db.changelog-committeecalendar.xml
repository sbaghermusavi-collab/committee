<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">


    <changeSet id="1-committeecalendar-create-table" author="seyyed">
        <createTable tableName="committee_calendar">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="committee_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="periodicity_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="meeting_model_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date_committee" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date_committee" type="DATE"/>
            <column name="first_date_meeting" type="DATE"/>
            <column name="next_plan_date_meeting" type="DATE"/>
            <column name="floating_days" type="INT"/>
            <column name="responsible_committee_position_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <!-- Auditable Fields -->
            <column name="d_created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="c_created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="d_last_modified_date" type="TIMESTAMP"/>
            <column name="c_last_modified_by" type="VARCHAR(255)"/>
            <column name="n_version" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseColumnNames="committee_id"
                baseTableName="committee_calendar"
                constraintName="fk_committeecalendar_committee"
                referencedColumnNames="id"
                referencedTableName="committee"/>

        <addForeignKeyConstraint
                baseColumnNames="periodicity_id"
                baseTableName="committee_calendar"
                constraintName="fk_committeecalendar_periodicity"
                referencedColumnNames="id"
                referencedTableName="base_info"/>

        <addForeignKeyConstraint
                baseColumnNames="meeting_model_id"
                baseTableName="committee_calendar"
                constraintName="fk_committeecalendar_meeting_model"
                referencedColumnNames="id"
                referencedTableName="base_info"/>

        <addForeignKeyConstraint
                baseColumnNames="responsible_committee_position_id"
                baseTableName="committee_calendar"
                constraintName="fk_committeecalendar_responsible_position"
                referencedColumnNames="id"
                referencedTableName="committee_position"/>
    </changeSet>

</databaseChangeLog>