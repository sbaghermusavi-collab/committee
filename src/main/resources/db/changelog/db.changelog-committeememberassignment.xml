<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">


<changeSet id="1-committeememberassignment-create-table" author="seyyed">
        <createTable tableName="committee_member_assignment">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="committee_position_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="nicico_position_id" type="VARCHAR(255)"/>
            <column name="national_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="alternate_member" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="alt_nicico_position_id" type="VARCHAR(255)"/>
            <column name="alt_member_national_code" type="VARCHAR(255)"/>
            <column name="nonicico_titel" type="VARCHAR(255)"/>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE"/>
            <column name="is_extend_date" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="document_ids" type="VARCHAR(255)"/>

            <!-- Auditable Fields -->
            <column name="d_created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="c_created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="d_last_modified_date" type="TIMESTAMP"/>
            <column name="c_last_modified_by" type="VARCHAR(255)"/>
            <column name="n_version" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseColumnNames="committee_position_id"
                baseTableName="committee_member_assignment"
                constraintName="fk_memberassignment_committeeposition"
                referencedColumnNames="id"
                referencedTableName="committee_position"/>
    </changeSet>

</databaseChangeLog>